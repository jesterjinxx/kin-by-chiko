---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Kin Concept Two">
  <main class="oh-page">
    <section class="oh-hero">
      <p class="eyebrow">Kin by Chiko</p>
      <h1>Interviews, gatherings, and dispatches on belonging.</h1>
    </section>

    <section class="oh-feature">
      <article class="oh-main-card">
        <img class="oh-card-image" src={`${import.meta.env.BASE_URL}/images/placeholders/portrait-2-p.jpg`} alt="Featured Kin Conversation" />
        <p class="eyebrow">Featured Conversation</p>
        <h2>What kind of belonging are we making?</h2>
        <p>
          A public humanities media studio using story, relationship, and gathering
          to explore culture, access, identity, and creative practice.
        </p>
        <a href="/stories">Read the feature →</a>
      </article>

      <aside class="oh-side-list">
        <h3>Latest</h3>
        <a href="#">Kin Interview: Creative practice and place</a>
        <a href="#">Dispatch: Notes on access and community</a>
        <a href="#">Gathering: A table for conversation</a>
      </aside>
    </section>

    <section class="oh-essays">
      <div class="section-heading">
        <p class="eyebrow">Recent Essays</p>
        <h2>Field notes from Kin</h2>
      </div>

      <div class="oh-card-grid">
        <article>
          <img src={`${import.meta.env.BASE_URL}/images/placeholders/portrait-1-p.jpg`} alt="Portrait placeholder" />
          <p class="eyebrow">Interview</p>
          <h3>Creative practice and place</h3>
        </article>

        <article>
          <img src={`${import.meta.env.BASE_URL}/images/placeholders/conversation-1-l.jpg`} alt="Conversation placeholder" />
          <p class="eyebrow">Dispatch</p>
          <h3>Notes on access and belonging</h3>
        </article>

        <article>
          <img src={`${import.meta.env.BASE_URL}/images/placeholders/portrait-2-p.jpg`} alt="Portrait placeholder" />
          <p class="eyebrow">Essay</p>
          <h3>The work of making room</h3>
        </article>
      </div>
    </section>

    <section class="oh-events">
      <p class="eyebrow">Upcoming Gatherings</p>

      <div class="oh-event-row">
        <span>June 14</span>
        <h3>Kin Salon No. 1</h3>
        <p>Traverse City, MI</p>
      </div>

      <div class="oh-event-row">
        <span>July 03</span>
        <h3>Live Taping: A Table for You</h3>
        <p>Partner venue TBA</p>
      </div>

      <div class="oh-event-row">
        <span>August 22</span>
        <h3>Community Dispatch Reading</h3>
        <p>Gallery / Library Space</p>
      </div>
    </section>

    <section class="oh-mission">
      <p class="eyebrow">Why Kin Exists</p>
      <h2>Story is not just content. It is a way of building relationship.</h2>
    </section>

    <section class="oh-newsletter">
      <h2>Receive the Dispatch.</h2>
      <p>Essays, interviews, and gathering notes from Kin by Chiko.</p>
      <a href="/newsletter" class="button primary">Subscribe</a>
    </section>
    <footer class="site-footer">
  <div class="footer-nav">
    <a href="/">Studio</a>
    <a href="/concept-two">Journal</a>
    <a href="/concept-three">Magazine</a>
    <a href="/stories">Stories</a>
    <a href="/gatherings">Gatherings</a>
    <a href="/about">About</a>
    <a href="/newsletter">Newsletter</a>
    <a href="/contact">Contact</a>
  </div>

  <p class="footer-credit">© 2026 Kin by Chiko</p>
</footer>
  </main>
</Layout>