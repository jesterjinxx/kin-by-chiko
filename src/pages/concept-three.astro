---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Kin Concept Three">
  <main class="provecho-page">
    <section class="provecho-hero">
      <div class="provecho-image">
        <img
          class="provecho-photo"
          src={`${import.meta.env.BASE_URL}images/placeholders/gathering-1-l.jpg`}
          alt="Kin gathering"
        />
      </div>

      <div class="provecho-text">
        <p class="eyebrow">Public Humanities Media Studio</p>
        <h1>Come in. We’re making something together.</h1>
        <p>
          Stories, interviews, and gatherings across disability, immigration,
          race, gender, art, and culture.
        </p>
      </div>
    </section>

    <section class="provecho-grid">
      <article>
        <p>01</p>
        <h2>Watch</h2>
        <span>Longform interviews and cinematic conversations.</span>
      </article>

      <article>
        <p>02</p>
        <h2>Read</h2>
        <span>Dispatches, essays, and reflections.</span>
      </article>

      <article>
        <p>03</p>
        <h2>Gather</h2>
        <span>Salons, live tapings, and community experiences.</span>
      </article>
    </section>

    <section class="mag-feature">
      <img src={`${import.meta.env.BASE_URL}images/placeholders/conversation-2-l.jpg`} alt="Conversation at Kin" />

      <div>
        <p class="eyebrow">Featured Story</p>
        <h2>A table for conversation.</h2>
        <p>
          Kin uses interviews and gatherings to turn story into relationship,
          and relationship into shared cultural practice.
        </p>
      </div>
    </section>

    <section class="mag-visual-grid">
      <article class="mag-large">
        <img src={`${import.meta.env.BASE_URL}images/placeholders/gathering-2-l.jpg`} alt="Kin gathering" />
        <h3>Gatherings that feel lived in.</h3>
      </article>

      <article>
        <img src={`${import.meta.env.BASE_URL}images/placeholders/connection-1-p.jpg`} alt="Connection placeholder" />
        <h3>Access as practice.</h3>
      </article>

      <article>
        <img src={`${import.meta.env.BASE_URL}images/placeholders/connection-3-p.jpg`} alt="Connection placeholder" />
        <h3>Belonging with accountability.</h3>
      </article>
    </section>

    <section class="mag-community">
      <img src={`${import.meta.env.BASE_URL}images/placeholders/connection-2-p.jpg`} alt="Hands reaching toward each other" />

      <div>
        <p class="eyebrow">Community</p>
        <h2>People like us do things like this.</h2>
        <p>
          Kin is built for culturally curious people who want depth, relationship,
          and participation instead of hot takes.
        </p>
      </div>
    </section>

    <section class="mag-newsletter">
      <h2>Join the Dispatch.</h2>
      <p>Stories, interviews, and gathering notes from Kin.</p>
      <a href="/newsletter" class="button secondary">Subscribe</a>
    </section>
    <footer class="site-footer">
  <div class="footer-nav">
    <a href={import.meta.env.BASE_URL}>Studio</a>
    <a href={`${import.meta.env.BASE_URL}concept-two`}>Journal</a>
    <a href={`${import.meta.env.BASE_URL}concept-three`}>Magazine</a>
    <a href={`${import.meta.env.BASE_URL}stories`}>Stories</a>
    <a href={`${import.meta.env.BASE_URL}gatherings`}>Gatherings</a>
    <a href={`${import.meta.env.BASE_URL}about`}>About</a>
    <a href={`${import.meta.env.BASE_URL}newsletter`}>Newsletter</a>
    <a href={`${import.meta.env.BASE_URL}contact`}>Contact</a>
  </div>

  <p class="footer-credit">© 2026 Kin by Chiko</p>
</footer>
  </main>
</Layout>